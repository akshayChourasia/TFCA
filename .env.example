# Postgres (Supabase in production)
DATABASE_URL=postgres://tfca:tfca@localhost:5432/tfca
# Optional: password for the seeded admin (mobile 9000000000). Generated if empty.
SEED_ADMIN_PASSWORD=
# Secret used to sign the internal render URL that headless Chromium opens for PDF export
RENDER_SECRET=change-me
# Optional: Chromium binary for PDF export (defaults to Playwright's bundled browser)
CHROMIUM_PATH=
# Optional: Ghostscript binary for CMYK PDF/X conversion
GS_PATH=gs
